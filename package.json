{
	"name": "pi-evolve",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
