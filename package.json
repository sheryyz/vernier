		"check": "npm run lint && npm run typecheck && npm run test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.9",
		"@types/node": "26.6.10",
		"typescript": "7.0.2",
		"vitest": "5.1.2"
	}
}
